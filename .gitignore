# --- Datos crudos: 3 GB, se regeneran con src/download/ (ver README) ---
data/raw/*
# ...excepto la prueba de qué se descargó
!data/raw/MANIFEST.csv

# --- Datos limpios demasiado grandes para GitHub (límite 100 MB por archivo) ---
